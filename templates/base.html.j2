<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ site.name }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ site.description }}{% endblock %}">
  <link rel="canonical" href="{{ site.base_url }}{{ canonical_path }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ self.title() }}">
  <meta property="og:description" content="{{ self.description() }}">
  <meta property="og:url" content="{{ site.base_url }}{{ canonical_path }}">
  <meta name="twitter:card" content="summary">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  {# 테마는 첫 화면을 그리기 전에 정해야 깜빡이지 않는다. 그래서 site.js 가 아니라 여기에 둔다. #}
  <script>
    (function () {
      try {
        var t = localStorage.getItem("ai24-theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/site.css">
  {% block head %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>

  <header class="masthead">
    <div class="masthead-inner">
      <a class="brand" href="/" aria-label="{{ site.name }} 홈">
        <span class="brand-mark" aria-hidden="true">24</span>
        <span class="brand-name">AI24Times</span>
      </a>
      <nav class="site-nav" aria-label="주요 메뉴">
        <a href="/" {% if nav == "today" %}aria-current="page"{% endif %}>오늘</a>
        <a href="/archive/" {% if nav == "archive" %}aria-current="page"{% endif %}>지난 호</a>
        <a href="/topics/" {% if nav == "topics" %}aria-current="page"{% endif %}>주제별</a>
        <a href="/glossary.html" {% if nav == "glossary" %}aria-current="page"{% endif %}>용어</a>
      </nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="밝게·어둡게 전환">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/>
        </svg>
      </button>
    </div>
  </header>

  <main id="main" class="page">
    {% block main %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <p class="footer-brand">{{ site.name }} · {{ site.tagline }}</p>
      <p class="footer-links">
        <a href="/archive/">지난 호</a>
        <a href="/topics/">주제별</a>
        <a href="/glossary.html">용어</a>
        <a href="/feed.xml">RSS</a>
      </p>
      <p class="footer-meta">매일 {{ "%02d"|format(site.publish_hour_kst) }}:00 KST 발행 · 마지막 빌드 {{ built_at.strftime("%Y-%m-%d %H:%M") }}</p>
    </div>
  </footer>

  {% block overlays %}{% endblock %}
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
