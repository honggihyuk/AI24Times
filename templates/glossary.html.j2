{% extends "base.html.j2" %}

{% block title %}용어 · {{ site.name }}{% endblock %}
{% block description %}브리핑에 나오는 AI 용어 {{ glossary|length }}개를 쉬운 말로 풀었습니다.{% endblock %}
{% block body_class %}page-glossary{% endblock %}

{% block main %}
<header class="page-header">
  <p class="kicker">용어</p>
  <h1 class="page-title">AI 용어 {{ glossary|length }}개</h1>
</header>

<dl class="glossary">
  {% for slug, t in glossary.items() %}
  <div class="glossary-item" id="{{ slug }}">
    <dt>{{ t.name }} <span class="glossary-en" lang="en">{{ t.en }}</span></dt>
    <dd>{{ t.body }}</dd>
  </div>
  {% endfor %}
</dl>
{% endblock %}
