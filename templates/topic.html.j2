{% extends "base.html.j2" %}
{% from "_macros.html.j2" import article_row %}

{% block title %}{{ topics[slug].name }} · {{ site.name }}{% endblock %}
{% block description %}{{ topics[slug].description }}{% endblock %}
{% block body_class %}page-topic{% endblock %}

{% block main %}
<header class="page-header">
  <p class="kicker"><a href="/topics/">주제별</a></p>
  <h1 class="page-title">{{ topics[slug].name }}</h1>
  <p class="page-sub">{{ topics[slug].description }} · {{ items|length }}건</p>
</header>

{% if items %}
<ul class="row-list">
  {% for a in items %}{{ article_row(a, topics) }}{% endfor %}
</ul>
{% else %}
<p class="empty">아직 이 주제로 고른 기사가 없습니다.</p>
{% endif %}
{% endblock %}
